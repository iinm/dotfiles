[init]
	defaultBranch = main

[core]
	trustctime = false
	excludesfile = ~/.gitignore-global
	ignorecase = false
	quotepath = false

[pull]
	ff = only

[merge]
	tool = vimdiff

[mergetool]
	prompt = true

[mergetool "vimdiff"]
	cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[difftool]
	prompt = false

[diff]
	tool = vimdiff

[rebase]
	instructionFormat = "%ai (%an) %s"
