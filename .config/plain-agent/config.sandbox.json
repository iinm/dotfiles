{
  "tools": {
    "tmux": { "enabled": false }
  },
  "autoApproval": {
    "defaultAction": "ask",
    "maxApprovals": 100,
    "allowGitUnmanagedFiles": true,
    "patterns": [
      {
        "toolName": "exec_command",
        "input": { "command": "find" },
        "action": "deny",
        "reason": "Use fd instead; fd respects .gitignore by default"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "grep" },
        "action": "deny",
        "reason": "Use rg instead; rg respects .gitignore by default"
      },

      {
        "toolName": "exec_command",
        "input": {
          "command": { "$regex": "^(npm|npx)$" },
          "args": [{ "$not": "--prefix" }]
        },
        "action": "deny",
        "reason": "Use npm/npx --prefix DIR to specify the directory"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": { "$regex": "^terraform$" },
          "args": [{ "$not": { "$regex": "^-chdir=" } }]
        },
        "action": "deny",
        "reason": "Use terraform -chdir=DIR to specify the directory"
      },

      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": [{ "$regex": "^(status|diff|log|show|ls-remote|rev-parse)$" }]
        },
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "input": {
          "command": "git",
          "args": [
            "-C",
            { "$regex": "." },
            { "$regex": "^(status|diff|log|show|ls-remote|rev-parse)$" }
          ]
        },
        "action": "allow"
      },

      {
        "toolName": "exec_command",
        "input": { "command": { "$regex": "^(git|gh|docker)$" } },
        "action": "ask"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "npm", "args": { "$has": { "$regex": "^(i|ci|install)$" } } },
        "action": "ask"
      },
      {
        "toolName": "exec_command",
        "input": { "command": "terraform", "args": { "$has": "init" } },
        "action": "ask"
      },

      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      },
      {
        "toolName": "compact_context",
        "action": "allow"
      },
      {
        "toolName": "exec_command",
        "action": "allow"
      }
    ],

    "tests": [
      {
        "desc": "git push should require approval",
        "toolUse": { "toolName": "exec_command", "input": { "command": "git", "args": ["push"] } },
        "expectedAction": "ask"
      },
      {
        "desc": "npm install should require approval",
        "toolUse": { "toolName": "exec_command", "input": { "command": "npm", "args": ["--prefix", ".", "install"] } },
        "expectedAction": "ask"
      },
      {
        "desc": "terraform init should require approval",
        "toolUse": { "toolName": "exec_command", "input": { "command": "terraform", "args": ["-chdir=.", "init"] } },
        "expectedAction": "ask"
      }
    ]
  },
  "sandbox": {
    "command": "plain-sandbox",
    "args": ["--allow-write", "--volume-each", "node_modules", "--keep-alive", "30"],
    "separator": "--",
    "rules": [
      {
        "pattern": { "command": { "$regex": "^(git|gh|docker)$" } },
        "mode": "unsandboxed"
      },
      {
        "pattern": {
          "command": "npm",
          "args": [
            "--prefix",
            { "$regex": "." },
            { "$regex": "^(i|ci|install)$" }
          ]
        },
        "mode": "sandbox",
        "additionalArgs": ["--allow-net", "0.0.0.0/0"]
      },
      {
        "pattern": {
          "command": "terraform",
          "args": [{ "$regex": "^-chdir=" }, "init"]
        },
        "mode": "sandbox",
        "additionalArgs": ["--allow-net", "0.0.0.0/0"]
      }
    ]
  }
}
