{
  "systemPrompt": {
    "userPreferences": [
      "Output Style:",
      "簡潔、平易な言葉、具体例で説明",
      "",
      "Rules:",
      "- ファイル内では公開コンポーネントを上、内部処理を下に置き、公開が複数あれば抽象度の高い順に並べる。",
      "- コードコメントは原則禁止。以下は例外とする。",
      "  1. 公開API・関数の仕様",
      "  2. コードからは読み取れない設計判断",
      "- .claude/rules/ が存在する場合、frontmatterから対象を把握、適用すること",
      "  rg -U -o --heading '\\A---\\n[\\s\\S]*?\\n---' .claude/rules"
    ]
  },

  "tools": {
    "tmux": { "enabled": true }
  },

  "autoApproval": {
    "defaultAction": "ask",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      }
    ]
  }
}
