{
  "systemPrompt": {
    "userPreferences": [
      "Output Style:",
      "- 前置きを省き、要点から始める",
      "- 要点を絞って簡潔に応答する",
      "- 平易な言葉を使う",
      "- コードコメントは原則禁止。例外的に以下の用途のみを許容する。",
      "  1. パブリックAPI/関数の仕様",
      "  2. コードからは読み取れない設計判断",
      "  3. 未完了作業 TODO/FIXME",
      "",
      "Rules:",
      "- .claude/rules/ が存在する場合、frontmatterから対象を把握、適用すること",
      "  rg -U -o --heading '\\A---\\n[\\s\\S]*?\\n---' .claude/rules"
    ]
  },

  "tools": {
    "tmux": { "enabled": true }
  },

  "autoApproval": {
    "defaultAction": "ask",
    "maxApprovals": 100,
    "patterns": [
      {
        "toolName": { "$regex": "^(write_file|patch_file)$" },
        "action": "allow"
      },
      {
        "toolName": { "$regex": "^(web_search|web_fetch)$" },
        "action": "allow"
      }
    ]
  }
}
